# Copy this file to .env (in this same folder) and fill in the values.
# .env is git-ignored; never commit real secrets.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True

# PostgreSQL (docker-compose maps the container's 5432 to 5433 on your machine)
DB_NAME=football
DB_USER=football
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5433

# football-data.org API token (free: https://www.football-data.org/client/register)
FOOTBALL_DATA_TOKEN=your-token-here

# Seasons are named by their start year (2026 = 2026/27).
# CURRENT_SEASON is worked out from today's date; set it only to override.
# FIRST_SEASON is the oldest season `sync_fixtures --all` loads.
FIRST_SEASON=2025
# CURRENT_SEASON=2026
